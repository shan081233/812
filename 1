<!doctype html>
<html lang="zh-Hant">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"><meta name="theme-color" content="#05070d"><title>花蓮 ↔ 上海</title>
<style>
:root{--bg:#05070d;--blue:#9aefff;--ink:#eff8ff;--muted:#8197aa;--line:rgba(154,239,255,.23)}*{box-sizing:border-box}html,body{height:100%;margin:0;overflow:hidden;background:var(--bg);color:var(--ink);font-family:"PingFang TC","Noto Sans TC","Microsoft JhengHei",sans-serif}button{font:500 12px Consolas,monospace;letter-spacing:.12em;color:var(--blue);background:rgba(89,195,255,.08);border:1px solid var(--line);border-radius:2px;min-height:48px;padding:0 20px;touch-action:manipulation;-webkit-tap-highlight-color:transparent}button:active{background:rgba(111,220,255,.24)}
#stars,#tapArea{position:fixed;inset:0;width:100%;height:100%}#stars{z-index:0;pointer-events:none}#tapArea{z-index:1;background:transparent}.shell{position:relative;z-index:2;min-height:100%;padding:calc(20px + env(safe-area-inset-top)) 20px calc(20px + env(safe-area-inset-bottom));display:flex;flex-direction:column;justify-content:space-between;pointer-events:none}.head,.foot{display:flex;justify-content:space-between;color:var(--muted);font:10px Consolas,monospace;letter-spacing:.1em}.head span:last-child{color:var(--blue)}.panel{pointer-events:auto;text-align:center;margin:auto 0}.orbital{position:relative;width:min(62vw,250px);aspect-ratio:1;margin:0 auto 28px;display:grid;place-items:center;touch-action:manipulation}.orbital:before,.orbital:after{content:"";position:absolute;border:1px solid var(--line);border-radius:50%}.orbital:before{inset:0;animation:spin 14s linear infinite}.orbital:after{inset:18%;border-color:rgba(154,239,255,.44)}.core{width:45%;aspect-ratio:1;border-radius:50%;background:radial-gradient(circle at 33% 28%,white 0 3%,#b9f8ff 9%,#3c9fc8 31%,#102a52 66%,#030814 74%);box-shadow:inset -14px -16px 21px #01030a,0 0 21px #7deaff,0 0 65px rgba(70,172,255,.42);animation:pulse 3s ease-in-out infinite}.signal{font:10px Consolas,monospace;letter-spacing:.17em;color:var(--blue)}h1{font-weight:300;font-size:clamp(34px,10vw,54px);letter-spacing:.15em;text-indent:.15em;line-height:1.35;margin:15px 0}h1 em{font-style:normal;color:var(--blue)}.copy{color:#a0b2c2;font-size:14px;font-weight:300;line-height:1.9;letter-spacing:.08em;margin:0 0 20px}.memory{width:min(385px,100%);margin:0 auto 20px;padding:12px 14px;text-align:left;border-left:1px solid var(--blue);background:linear-gradient(90deg,rgba(96,199,255,.11),transparent);color:#c7d8e4;font-size:13px;line-height:1.55;cursor:pointer;touch-action:manipulation}.memory small{display:block;margin-bottom:5px;color:#6f94ab;font:9px Consolas,monospace;letter-spacing:.12em}.facts{display:flex;justify-content:center;margin:0 auto 24px;border-top:1px solid var(--line);border-bottom:1px solid var(--line);width:min(370px,100%)}.facts div{flex:1;padding:10px 5px;color:var(--muted);font:9px Consolas,monospace}.facts div+div{border-left:1px solid var(--line)}.facts b{display:block;margin-bottom:3px;color:var(--ink);font-weight:400}.intro,.thanks{position:fixed;z-index:10;inset:0;display:grid;place-items:center;padding:25px;background:#05070d;text-align:center}.intro.hide{opacity:0;pointer-events:none;transition:opacity .6s}.intro .route{width:min(560px,85vw);display:flex;align-items:center;justify-content:space-between;color:#c8e6f0;font:11px Consolas,monospace;letter-spacing:.12em}.route i{width:8px;height:8px;background:var(--blue);border-radius:50%;box-shadow:0 0 20px var(--blue)}.route:before{content:"";position:absolute;height:1px;left:calc(50% - min(280px,42.5vw));right:calc(50% - min(280px,42.5vw));background:linear-gradient(90deg,transparent,var(--blue),transparent)}.intro h2,.thanks h2{font-size:clamp(29px,8vw,44px);font-weight:300;line-height:1.55;letter-spacing:.15em;text-indent:.15em;margin:40px 0 25px}.intro p,.thanks p{color:#9db2c2;font-size:14px;line-height:2;letter-spacing:.08em}.thanks{display:none;background:rgba(5,7,13,.93)}.thanks.show{display:grid}.thanks i{width:8px;height:8px;background:var(--blue);border-radius:50%;box-shadow:0 0 28px 8px var(--blue);margin:auto}.hint{opacity:.65}@keyframes spin{to{transform:rotate(360deg)}}@keyframes pulse{50%{transform:scale(1.07);filter:brightness(1.25)}}@media(max-height:680px){.orbital{width:135px;margin-bottom:10px}.copy{display:none}.memory{margin-bottom:12px}.facts{margin-bottom:12px}h1{margin:8px 0}.intro h2{margin:22px 0}}
</style>
</head>
<body>
<canvas id="stars"></canvas><div id="tapArea" aria-label="點擊留下陪伴星"></div>
<div class="shell"><header class="head"><span>DISTANCE / 08.12</span><span>HUALIEN ↔ SHANGHAI</span></header><main class="panel"><div class="orbital" id="orbital" role="button" aria-label="啟動連線"><div class="core"></div></div><div class="signal" id="signal">806 KM / SIGNAL LINE</div><h1>距離很遠，<br><em>此刻很近。</em></h1><p class="copy">謝謝你跨過時間與距離，<br>來到這個瞬間。</p><div class="memory" id="memory"><small>LEAVE A SMALL LIGHT / TAP TO CHANGE</small><span id="memoryText">你到這裡的時候，已經是陪伴。</span></div><div class="facts"><div><b>HUALIEN</b>ORIGIN</div><div><b>806 KM</b>DISTANCE</div><div><b>SHANGHAI</b>DESTINATION</div></div><button id="send" type="button">傳送陪伴訊號</button></main><footer class="foot"><span id="count">點空白處，留下陪伴星 00</span><span id="clock">00:00</span></footer></div>
<section class="intro" id="intro"><div><div class="route"><span><i></i> HUALIEN</span><span><i></i> SHANGHAI</span></div><h2>有些距離，<br>不是為了讓人分開。</h2><p>806 公里之外，訊號正在抵達。</p><button id="enter" type="button">進入這個瞬間 →</button><p class="hint">或等待連線完成</p></div></section>
<section class="thanks" id="thanks"><div><i></i><h2>謝謝你的出現。<br>讓這段距離，有了光。</h2><p>不必靠得很近，<br>也能在彼此的夜裡留下亮點。</p><button id="back" type="button">回到星圖</button></div></section>
<script>
(function(){
  var intro=document.getElementById('intro'), thanks=document.getElementById('thanks'), count=0, memories=['你到這裡的時候，已經是陪伴。','有些人不在身邊，卻一直在心裡。','806 公里之外，也能共享同一個時刻。','希望這束光，剛好落在你眼前。'], m=0;
  function leave(){if(!intro)return;intro.className='intro hide';setTimeout(function(){if(intro&&intro.parentNode)intro.parentNode.removeChild(intro)},650)}
  document.getElementById('enter').onclick=leave; document.getElementById('enter').ontouchend=function(e){e.preventDefault();leave()}; setTimeout(leave,4000);
  function activate(){var o=document.getElementById('orbital'),s=document.getElementById('signal');o.style.transform='scale(1.05)';s.innerHTML='SIGNAL MOVING / 806 KM';setTimeout(function(){o.style.transform='';s.innerHTML='806 KM / SIGNAL LINE'},1100)}
  document.getElementById('orbital').onclick=activate;document.getElementById('orbital').ontouchend=function(e){e.preventDefault();activate()};
  document.getElementById('send').onclick=function(){activate();setTimeout(function(){thanks.className='thanks show'},750)};document.getElementById('send').ontouchend=function(e){e.preventDefault();this.onclick()};document.getElementById('back').onclick=function(){thanks.className='thanks'};
  document.getElementById('memory').onclick=function(){m=(m+1)%memories.length;document.getElementById('memoryText').innerHTML=memories[m]};document.getElementById('memory').ontouchend=function(e){e.preventDefault();this.onclick()};
  document.getElementById('tapArea').onclick=function(e){count++;document.getElementById('count').innerHTML='已留下陪伴星 '+('0'+count).slice(-2);beacon(e.clientX,e.clientY)};document.getElementById('tapArea').ontouchend=function(e){e.preventDefault();var t=e.changedTouches[0];this.onclick({clientX:t.clientX,clientY:t.clientY})};
  var c=document.getElementById('stars'),x=c.getContext('2d'),w,h,d,stars=[];function resize(){d=Math.min(window.devicePixelRatio||1,2);w=innerWidth;h=innerHeight;c.width=w*d;c.height=h*d;x.setTransform(d,0,0,d,0,0);stars=[];for(var i=0;i<95;i++)stars.push({x:Math.random()*w,y:Math.random()*h,a:.15+Math.random()*.45})}function beacon(px,py){stars.push({x:px,y:py,a:1,b:Date.now()})}function draw(){x.clearRect(0,0,w,h);for(var i=stars.length-1;i>=0;i--){var p=stars[i];if(p.b&&Date.now()-p.b>3400){stars.splice(i,1);continue}x.fillStyle='rgba(160,235,255,'+p.a+')';x.fillRect(p.x,p.y,2,2);if(p.b){var r=(Date.now()-p.b)/28;x.beginPath();x.arc(p.x,p.y,r,0,Math.PI*2);x.strokeStyle='rgba(154,239,255,'+(1-r/120)+')';x.stroke()}}requestAnimationFrame(draw)}resize();addEventListener('resize',resize);draw();setInterval(function(){document.getElementById('clock').innerHTML=new Date().toLocaleTimeString('en-GB',{hour:'2-digit',minute:'2-digit'})},1000)
})();
</script></body></html>
